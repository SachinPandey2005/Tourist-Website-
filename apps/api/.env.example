# Server Port
PORT=5000

# Environment Mode
NODE_ENV=development

# Allowed Frontend Origins (CORS - comma separated for multiple allowlisted domains)
CORS_ORIGIN=http://localhost:5173

# Frontend Application URL (for password reset links)
APP_URL=http://localhost:5173

# PostgreSQL Database Connection String
# Local PostgreSQL instance:
DATABASE_URL="postgresql://postgres:password@localhost:5432/tourist_db?schema=public"

# Cloud Providers (Neon / Supabase / AWS RDS):
# Use ?sslmode=require for secure cloud connections
# DATABASE_URL="postgresql://username:password@hostname:5432/tourist_db?sslmode=require"
# DIRECT_URL="postgresql://username:password@direct-hostname:5432/tourist_db?sslmode=require"

# JWT Authentication Secrets (Must be at least 32 characters in production)
JWT_SECRET="replace_with_a_secure_random_secret_at_least_32_characters_long"
JWT_EXPIRES_IN="7d"

# Cookie Signing Secret
COOKIE_SECRET="replace_with_a_secure_cookie_signing_secret"

# Email Provider for Password Reset ('console' | 'smtp' | 'sendgrid' | 'resend' | 'none')
# In development/test with 'console', reset tokens and URLs are logged safely to the terminal without pretending emails were dispatched.
EMAIL_PROVIDER=console

# Brute-Force Rate Limiting for Auth Endpoints (/api/auth/login, register, forgot-password)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
