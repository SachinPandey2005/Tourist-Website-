# Server Port
PORT=5000

# Environment Mode
NODE_ENV=development

# Allowed Frontend Origins (CORS)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection String
# Local PostgreSQL instance:
DATABASE_URL="postgresql://postgres:password@localhost:5432/tourist_db?schema=public"

# Cloud Providers (Neon / Supabase / AWS RDS):
# Use ?sslmode=require for secure cloud connections
# DATABASE_URL="postgresql://username:password@hostname:5432/tourist_db?sslmode=require"
# DIRECT_URL="postgresql://username:password@direct-hostname:5432/tourist_db?sslmode=require"
