# ==========================================
# Root Environment Variables Template
# Copy this or app-specific .env.example files to .env in respective directories.
# ==========================================

# Database Configuration (PostgreSQL)
# Standard local connection:
DATABASE_URL="postgresql://postgres:password@localhost:5432/tourist_db?schema=public"

# Cloud PostgreSQL Providers (e.g., Supabase / Neon / AWS RDS):
# If using a connection pooler (e.g., PgBouncer), provide pooled DATABASE_URL and direct connection DIRECT_URL:
# DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-1.postgres.neon.tech/tourist_db?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://user:password@ep-sample.us-east-1.postgres.neon.tech/tourist_db?sslmode=require"

# Backend API Configuration
PORT=5000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"

# Frontend Web Configuration
VITE_API_URL="http://localhost:5000"
